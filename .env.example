# Copiá este archivo como .env.local (no se sube a GitHub) y completá los datos.
# Mercado Pago: "Tus integraciones" > tu aplicación > Credenciales (Access Token, empieza con APP_USR-).
# Los tokens TEST- no sirven con la API de Orders: para probar, usá las credenciales de una cuenta de prueba vendedora.
# Si está vacío, el pago se simula.
MP_ACCESS_TOKEN=
# Opcional: "Tus integraciones" > Webhooks (evento "Order") > Clave secreta. Valida que los avisos vengan de Mercado Pago.
MP_WEBHOOK_SECRET=
# Opcional: dirección pública de la tienda. Si no está, se usa la del dominio actual.
SITE_URL=

# Base de datos de pedidos: en Vercel, Storage > Neon (Postgres) y conectarla al proyecto.
# Vercel carga DATABASE_URL sola. Para probar en local, copiá ese valor acá.
DATABASE_URL=
# Contraseña del panel del local (/admin).
ADMIN_PASSWORD=
# Fotos de productos: en Vercel, Storage > Blob (público) y conectarlo al proyecto. Vercel la carga sola.
BLOB_READ_WRITE_TOKEN=

# Aviso por mail de cada venta pagada (al local y a los proveedores) y de cada pedido de arrepentimiento.
# A qué mail llegan los avisos del local. Se pueden poner varios separados por coma.
NOTIFY_EMAIL=
# Con Gmail (recomendado): el Gmail que manda y una contraseña de aplicación (myaccount.google.com/apppasswords,
# con verificación en dos pasos activada). No es la contraseña normal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternativa si no hay Gmail: Resend (resend.com). Sin dominio verificado solo manda al mail de la cuenta.
RESEND_API_KEY=
# Opcional, cuando el dominio esté verificado en Resend: LIBRE <ventas@tudominio.com.ar>
MAIL_FROM=
