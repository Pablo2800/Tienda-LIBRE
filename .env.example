# Copiá este archivo como .env.local (no se sube a GitHub) y completá los datos.
# Las credenciales están en el panel de Uber Direct, pestaña Developer.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=

# Dirección de retiro (el local). Opcional: si no está, usa la de ejemplo.
STORE_STREET=Av. San Martín 1200
STORE_CITY=Ciudad de Mendoza
STORE_ZIP=5500

# Mercado Pago: "Tus integraciones" > tu aplicación > Credenciales (Access Token).
# Si está vacío, el pago se simula.
MP_ACCESS_TOKEN=
# Opcional: "Tus integraciones" > Webhooks > Clave secreta. Valida que los avisos vengan de Mercado Pago.
MP_WEBHOOK_SECRET=
# Opcional: dirección pública de la tienda. Si no está, se usa la del dominio actual.
SITE_URL=

# Base de datos de pedidos: en Vercel, Storage > Neon (Postgres) y conectarla al proyecto.
# Vercel carga DATABASE_URL sola. Para probar en local, copiá ese valor acá.
DATABASE_URL=
# Contraseña del panel de pedidos (/admin).
ADMIN_PASSWORD=
